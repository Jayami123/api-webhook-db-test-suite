# Copy to .env. Never commit .env. Names only; leave a line empty to use the default.
# Folder that holds the product forks (harness folder names: cal, documenso, medusa-dtc-starter, twenty-CRM).
# Default when unset: ../products next to this repo.
PRODUCTS_ROOT=
# Products scripts/cloud-install.sh prepares (space-separated). Default: medusa twenty documenso cal
P2_BOOTSTRAP_PRODUCTS=
# Node 24 binary for Documenso harness commands. Cloud default: /opt/node24/bin/node
NODE24=
# Webhook receiver (src/webhooks/receiver.ts). Default 127.0.0.1:4317.
P2_RECEIVER_HOST=
P2_RECEIVER_PORT=
# Product base URLs (127.0.0.1 only). Defaults: Cal 3000 / API v2 5555, Documenso 3001, Medusa 9000, Twenty 3002.
CAL_BASE_URL=
CAL_API_BASE_URL=
DOCUMENSO_BASE_URL=
MEDUSA_BASE_URL=
TWENTY_BASE_URL=
# Read-only oracle DB URLs. Leave empty to use the harness defaults.
CAL_DB_URL=
DOCUMENSO_DB_URL=
MEDUSA_DB_URL=
TWENTY_DB_URL=
# Run prefix shared by every entity a run creates. Leave empty: playwright.config.ts generates
# p2-qa-<utc>-<8 hex>. CI may preset it; it must match that pattern.
P2_RUN_ID=
# Read-only oracle statement timeout in ms (100-600000). Default 5000.
P2_DB_STATEMENT_TIMEOUT_MS=
